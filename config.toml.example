# makeros native-print hub agent — config (non-secret).
# Installed to /etc/makeros-hub/config.toml.
#
# The per-hub credential is NOT here — it's written 0600 to
# /var/lib/makeros-hub/credential during enrollment, and never logged.

# The makeros cloud base URL this hub reports to (your prod host).
# The hub→cloud link is outbound HTTPS only. Inbound listeners include the manual
# ingest server below and configured virtual printers on the member/shop network.
cloud_url = "https://procrastinationstation.net"

# Heartbeat cadence in seconds. The cloud can override this per heartbeat
# response (nextPollMs), so you rarely need to change it here.
heartbeat_sec = 30

# The OrcaSlicer ingest server binds this (non-privileged) LAN port. Members
# point OrcaSlicer's Print Host at http://<this-hub>.local:<ingest_port>.
ingest_port = 8787

# Cap a single raw sliced-file upload, in MiB (streamed to disk).
max_upload_mb = 1024

# Staff-only Moonraker trial. Fixed defaults; changing ingest_port does not move these.
# Overrides need matching Orca presets, operator-only ACL and userspace forwards; restart the hub after review.
# [moonraker_ports]
# sv08-max = 8810
# giga = 8811
# p2s = 8812
# a1-mini = 8813
# x1c = 8814

# Lasers (v0.68). Optional; without it every laser reports "not configured". See docs/laser-ha.md.
# [laser]
# ha_push_listen = "0.0.0.0:8788"
# ha_push_allowed_ip = "192.168.1.213"   # Home Assistant; every other source gets 403
# gate_url = "http://127.0.0.1:7650"     # omit until the gate is installed; loopback or a private IPv4 only
# cutting_amps = 2.0
# on_amps = 0.5
# run_gap_s = 60
